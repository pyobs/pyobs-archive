SECRET_KEY=changeme
DEBUG=0
ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Origins (scheme + host [+ port]) allowed to make cross-origin requests to the API,
# e.g. a frontend served from a different host/port.
# CORS_ALLOWED_ORIGINS=http://localhost:8098,https://your.domain.com

POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=secret

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=archive
SQL_USER=archive
SQL_PASSWORD=secret
SQL_HOST=db
SQL_PORT=5432

STATIC_ROOT=/static/

# Where FITS files are stored/served from - mount this as a volume.
ARCHIVE_ROOT=/data/
# PATH_FORMATTER={SITEID}/{DAY-OBS}/
# FILENAME_FORMATTER=

DJANGO_LOG_LEVEL=INFO

# OAuth login (optional)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_TOKEN_URL=http://localhost/o/token/
# OAUTH_PROFILE_URL=http://localhost/api/profile/
