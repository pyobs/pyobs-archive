SECRET_KEY=changeme
DEBUG=0
ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Origins (scheme + host [+ port]) allowed to make cross-origin requests to the API,
# e.g. a frontend served from a different host/port.
# CORS_ALLOWED_ORIGINS=http://localhost:8098,https://your.domain.com

POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=secret

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=archive
SQL_USER=archive
SQL_PASSWORD=secret
SQL_HOST=db
SQL_PORT=5432

STATIC_ROOT=/static/

# Where FITS files are stored/served from - mount this as a volume.
ARCHIVE_ROOT=/data/
# PATH_FORMATTER={SITEID}/{DAY-OBS}/
# FILENAME_FORMATTER=

DJANGO_LOG_LEVEL=INFO

# Keycloak login (optional addon on top of local Django username/password, not a replacement -
# leave SERVER_URL unset to disable it entirely; the login page won't show the button either).
# KEYCLOAK_SERVER_URL=https://keycloak.example.org
# KEYCLOAK_REALM=pyobs
# KEYCLOAK_CLIENT_ID=archive
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://your.domain.com/accounts/keycloak/callback/
# Optional one-click IdP login: hint passed to Keycloak as kc_idp_hint (skips its
# login/IdP-selection page, going straight to that identity provider) plus the label
# shown on the login page's IdP button.
# KEYCLOAK_IDP_HINT=gwdg
# KEYCLOAK_IDP_LABEL=GWDG

# Settings-configured superuser (optional), synced automatically after every `migrate` -
# skips the interactive `createsuperuser` step. Leave ADMIN_USERNAME unset to opt out.
# Generate the hash: uv run python -c \
#   "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=

# pyobs-portal connection (optional): used to mirror projects/members
# (`manage.py sync_projects`) and to resolve REQNUM to a project at ingest time.
# PORTAL_URL=https://portal.example.org
# PORTAL_TOKEN=
# PORTAL_TIMEOUT=5

# Restrict frame access to project members (+ public projects). Leave unset/false to keep
# today's behavior (no access filtering) - this is independent of PORTAL_URL above,
# so configuring the backend connection alone does not change existing behavior.
# PROJECT_ACCESS_CONTROL=false
